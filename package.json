    "@capacitor/status-bar": "^8.0.4",
    "leaflet": "^1.9.4",
    "next": "^15.5.29",
    "openai": "^7.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/leaflet": "^1.9.22",
